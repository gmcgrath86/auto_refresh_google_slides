-- Slides hotkey + HTTP endpoints (Hammerspoon)
-- Homebrew install (recommended): brew install --cask hammerspoon
-- Manual install (no Homebrew): download latest .dmg from
-- https://github.com/Hammerspoon/hammerspoon/releases/latest and drag to /Applications
-- Save as ~/.hammerspoon/init.lua (or merge into your existing init.lua).

require("hs.ipc")

local projectRoot = "/ABSOLUTE/PATH/auto_refresh_google_slides"
local triggerScript = projectRoot .. "/scripts/slides_hotkey_trigger.sh"

-- Choose mode: "local" (this machine), "relay", or "ssh"
local triggerMode = "local"
local triggerConfig = projectRoot .. "/config/local.env"

-- Global hotkey (works while Chrome is fullscreen)
local hotkeyMods = {"ctrl", "alt", "cmd"}
local hotkeyKey = "r"

-- HTTP control endpoint (for remote curl triggers on same VLAN)
local httpInterface = "en0"
local httpPort = 8765
local iCloudDriveRoot = os.getenv("HOME") .. "/Library/Mobile Documents/com~apple~CloudDocs"
local keynoteBundleId = "com.apple.Keynote"
local keynoteAppPaths = {
  "/Applications/Keynote.app",
  "/Applications/Keynote Creator Studio.app",
}
local keynoteSlideDisplay = "extended"
local keynoteNotesDisplay = "desktop"
-- Automatically bias presenter view toward speaker notes after a successful run.
-- Set to 0 to disable automatic post-run layout adjustment.
local defaultNotesLayoutNotesPercent = 80

local setNotesPaneLayout
local refreshRunSequence = 0
local refreshRunsById = {}
local refreshRunOrder = {}
local activeRefreshRunId = nil
local activeRefreshTask = nil
local maxRefreshRunsToKeep = 20

local function isoTimestamp()
  return os.date("!%Y-%m-%dT%H:%M:%SZ")
end

local function summarizeText(value, maxLen)
  local text = tostring(value or "")
  text = text:gsub("\r\n", "\n")
  text = text:gsub("\r", "\n")
  text = text:gsub("^%s+", "")
  text = text:gsub("%s+$", "")

  if #text == 0 then
    return nil
  end

  maxLen = maxLen or 2000
  if #text > maxLen then
    text = "..." .. text:sub(#text - maxLen + 4)
  end

  return text
end

local function nextRefreshRunId()
  refreshRunSequence = refreshRunSequence + 1
  return string.format("%s-%04d", os.date("!%Y%m%dT%H%M%SZ"), refreshRunSequence)
end

local function trackRefreshRun(run)
  refreshRunsById[run.runId] = run

  if not run._tracked then
    run._tracked = true
    table.insert(refreshRunOrder, run.runId)
  end

  while #refreshRunOrder > maxRefreshRunsToKeep do
    local oldestRunId = table.remove(refreshRunOrder, 1)
    if oldestRunId ~= activeRefreshRunId then
      refreshRunsById[oldestRunId] = nil
    end
  end
end

local function buildRefreshRunPayload(run)
  if not run then
    return {
      ok = true,
      accepted = false,
      state = "idle",
      running = false,
      completed = false,
      message = "no refresh has been triggered yet",
    }
  end

  return {
    ok = run.state ~= "failed",
    accepted = run.accepted == true,
    runId = run.runId,
    state = run.state,
    running = run.state == "running",
    completed = run.state == "succeeded" or run.state == "failed",
    message = run.message,
    acceptedAt = run.acceptedAt,
    startedAt = run.startedAt,
    finishedAt = run.finishedAt,
    exitCode = run.exitCode,
    error = run.error,
    detail = run.detail,
    action = run.action,
    presentationId = run.presentationId,
    presentationTitle = run.presentationTitle,
    presentationUrl = run.presentationUrl,
    stdout = run.stdout,
    stderr = run.stderr,
    layoutDetail = run.layoutDetail,
    statusPath = "/slides/status/" .. run.runId,
  }
end

local function makeRefreshFailureDetail(exitCode, stdOut, stdErr, layoutDetail)
  local stderrSummary = summarizeText(stdErr, 1200)
  local stdoutSummary = summarizeText(stdOut, 1200)
  local layoutSummary = summarizeText(layoutDetail, 1200)

  if tonumber(exitCode or 0) ~= 0 then
    return stderrSummary or stdoutSummary or ("refresh script exited with code " .. tostring(exitCode))
  end

  return layoutSummary or "refresh finished with an unknown error"
end

local function completeRefreshRun(runId, exitCode, stdOut, stdErr)
  local run = refreshRunsById[runId]
  if not run then
    return
  end

  local layoutOk = true
  local layoutDetail = nil

  if tonumber(exitCode or 0) == 0 and defaultNotesLayoutNotesPercent > 0 and setNotesPaneLayout then
    local ok, resultOk, resultDetail = pcall(setNotesPaneLayout, defaultNotesLayoutNotesPercent)
    if ok then
      layoutOk = resultOk
      layoutDetail = resultDetail
    else
      layoutOk = false
      layoutDetail = tostring(resultOk)
    end
  end

  run.finishedAt = isoTimestamp()
  run.exitCode = tonumber(exitCode or 0) or 0
  run.stdout = summarizeText(stdOut, 2000)
  run.stderr = summarizeText(stdErr, 2000)
  run.layoutDetail = summarizeText(layoutDetail, 1000)

  if run.exitCode == 0 and layoutOk ~= false then
    run.state = "succeeded"
    run.message = run.action .. " finished"
    run.detail = "all " .. run.action .. " steps completed successfully"
    run.error = nil
  else
    run.state = "failed"
    run.message = run.action .. " failed"
    run.detail = "one or more " .. run.action .. " steps failed"
    run.error = makeRefreshFailureDetail(run.exitCode, stdOut, stdErr, layoutDetail)
  end

  activeRefreshRunId = nil
  activeRefreshTask = nil
  trackRefreshRun(run)

  if run.layoutDetail and #run.layoutDetail > 0 then
    print(run.layoutDetail)
  end
  if stdOut and #stdOut > 0 then print(stdOut) end
  if stdErr and #stdErr > 0 then print(stdErr) end
end

local function runSlidesTrigger(options)
  options = options or {}
  local action = options.action or "refresh"
  local actionLabel = action == "load" and "Deck load" or "Refresh"

  if activeRefreshRunId then
    local activeRun = refreshRunsById[activeRefreshRunId]
    hs.notify.new({ title = "Slides", informativeText = actionLabel .. " already running" }):send()
    return false, activeRun, "refresh-already-running"
  end

  local run = {
    runId = nextRefreshRunId(),
    action = action,
    presentationId = options.presentationId,
    presentationTitle = options.presentationTitle,
    presentationUrl = options.presentationUrl,
    accepted = true,
    state = "running",
    message = action .. " accepted and started",
    detail = "the " .. action .. " command was accepted and execution has started",
    acceptedAt = isoTimestamp(),
    startedAt = isoTimestamp(),
  }
  trackRefreshRun(run)
  activeRefreshRunId = run.runId

  local args = {"--mode", triggerMode, "--config", triggerConfig}
  if options.slidesUrl and #options.slidesUrl > 0 then
    table.insert(args, "--slides-url")
    table.insert(args, options.slidesUrl)
  end

  local task = hs.task.new(triggerScript, function(exitCode, stdOut, stdErr)
    completeRefreshRun(run.runId, exitCode, stdOut, stdErr)
    local completedRun = refreshRunsById[run.runId]

    if completedRun and completedRun.state == "succeeded" then
      hs.notify.new({ title = "Slides", informativeText = actionLabel .. " finished" }):send()
    else
      local failureText = actionLabel .. " failed"
      if completedRun and completedRun.error and #completedRun.error > 0 then
        failureText = completedRun.error
      elseif exitCode ~= nil then
        failureText = actionLabel .. " failed (" .. tostring(exitCode) .. ")"
      end
      hs.notify.new({ title = "Slides", informativeText = failureText }):send()
    end

    return true
  end, args)

  if not task then
    run.state = "failed"
    run.message = action .. " failed"
    run.detail = "failed to create the " .. action .. " task"
    run.error = "failed to create the " .. action .. " task"
    run.finishedAt = isoTimestamp()
    activeRefreshRunId = nil
    activeRefreshTask = nil
    trackRefreshRun(run)
    hs.notify.new({ title = "Slides", informativeText = "Failed to create " .. action .. " task" }):send()
    return false, run, "failed-to-create-task"
  end

  activeRefreshTask = task
  local started = task:start()
  if not started then
    run.state = "failed"
    run.message = action .. " failed"
    run.detail = "failed to start the " .. action .. " task"
    run.error = "failed to start the " .. action .. " task"
    run.finishedAt = isoTimestamp()
    activeRefreshRunId = nil
    activeRefreshTask = nil
    trackRefreshRun(run)
    hs.notify.new({ title = "Slides", informativeText = "Failed to start " .. action .. " task" }):send()
    return false, run, "failed-to-start-task"
  end

  return true, run
end

hs.hotkey.bind(hotkeyMods, hotkeyKey, runSlidesTrigger)
print("Slides hotkey ready: " .. table.concat(hotkeyMods, "+") .. "+" .. string.upper(hotkeyKey))

if _G.slidesHttpServer then
  _G.slidesHttpServer:stop()
  _G.slidesHttpServer = nil
end

local function jsonResponse(body, status)
  return body, status, { ["Content-Type"] = "application/json" }
end

local function jsonResponseValue(value, status)
  local ok, encoded = pcall(hs.json.encode, value)
  if not ok or not encoded then
    return jsonResponse('{"ok":false,"error":"json-encode-failed"}', 500)
  end

  return jsonResponse(encoded, status)
end

local function jsonEscape(value)
  local text = tostring(value or "")
  text = text:gsub("\\", "\\\\")
  text = text:gsub('"', '\\"')
  return text
end

local function splitRouteAndQuery(path)
  local qmark = path:find("?", 1, true)
  if qmark then
    return path:sub(1, qmark - 1), path:sub(qmark + 1)
  end
  return path, ""
end

local function parsePositiveInt(rawValue)
  local token = tostring(rawValue or ""):match("^(%d+)$")
  if not token then return nil end
  local parsed = tonumber(token)
  if not parsed or parsed < 1 then return nil end
  return math.floor(parsed)
end

local function parseNumericQueryValue(query, acceptedKeys)
  if #query == 0 then return nil end
  for pair in query:gmatch("[^&]+") do
    local key, value = pair:match("^([^=]+)=?(.*)$")
    for _, candidate in ipairs(acceptedKeys) do
      if key == candidate then
        return parsePositiveInt(value)
      end
    end
  end
  return nil
end

local function urlDecode(value)
  local text = tostring(value or "")
  text = text:gsub("+", " ")
  text = text:gsub("%%(%x%x)", function(hex)
    return string.char(tonumber(hex, 16))
  end)
  return text
end

local function parseQueryValues(query)
  local values = {}
  if #query == 0 then
    return values
  end

  for pair in query:gmatch("[^&]+") do
    local rawKey, rawValue = pair:match("^([^=]+)=?(.*)$")
    if rawKey and #rawKey > 0 then
      values[urlDecode(rawKey)] = urlDecode(rawValue or "")
    end
  end

  return values
end

local function isValidPresentationId(value)
  return type(value) == "string" and value:match("^[%w_-]+$") ~= nil
end

local function parseSlidesLoadRequest(path)
  local route, query = splitRouteAndQuery(path)
  if route ~= "/slides/load" then
    return nil, nil
  end

  local values = parseQueryValues(query)
  local presentationId = values.presentation_id or values.id or ""
  local presentationTitle = values.title or ""
  local presentationUrl = values.presentation_url or values.url or ""
  local sourceUrl = presentationUrl

  if #sourceUrl == 0 and isValidPresentationId(presentationId) then
    sourceUrl = "https://docs.google.com/presentation/d/" .. presentationId .. "/edit"
  end

  if not sourceUrl:match("^https?://") or not sourceUrl:find("docs.google.com/presentation/d/", 1, true) then
    return nil, "missing-or-invalid-presentation-url"
  end

  return {
    presentationId = presentationId,
    presentationTitle = presentationTitle,
    presentationUrl = #presentationUrl > 0 and presentationUrl or sourceUrl,
    slidesUrl = sourceUrl,
  }, nil
end

local function parseKeynoteLoadRequest(path)
  local route, query = splitRouteAndQuery(path)
  if route ~= "/keynote/load" then
    return nil, nil
  end

  local values = parseQueryValues(query)
  local relativePath = values.icloud_relative_path or values.path or ""
  local title = values.title or ""
  local mode = values.mode or "present"
  local slide = parsePositiveInt(values.slide or "1") or 1

  if #relativePath == 0 then
    return nil, "missing-icloud-relative-path"
  end
  if relativePath:sub(1, 1) == "/" or relativePath:find("..", 1, true) then
    return nil, "invalid-icloud-relative-path"
  end
  if not relativePath:match("%.key$") then
    return nil, "not-a-keynote-deck"
  end
  if mode ~= "present" and mode ~= "open" then
    return nil, "invalid-mode"
  end

  return {
    title = title,
    relativePath = relativePath,
    mode = mode,
    slide = slide,
    resolvedPath = iCloudDriveRoot .. "/" .. relativePath,
  }, nil
end

local function parseSlideNumberFromPath(path)
  local route, query = splitRouteAndQuery(path)

  local byRoute = route:match("^/slides/jump/(%d+)$")
  if byRoute then
    return tonumber(byRoute)
  end

  if route == "/slides/jump" then
    local byQuery = parseNumericQueryValue(query, {"slide", "n"})
    if byQuery then return byQuery end
  end

  return nil
end

local function parseNotesFontRequest(path)
  local route, query = splitRouteAndQuery(path)

  local byRouteDirection, byRouteSteps = route:match("^/slides/notes/font/([%a]+)/(%d+)$")
  if byRouteDirection and byRouteSteps then
    if byRouteDirection == "up" or byRouteDirection == "down" then
      return byRouteDirection, tonumber(byRouteSteps), nil
    end
    return nil, nil, "missing-or-invalid-direction"
  end

  local directionOnly = route:match("^/slides/notes/font/([%a]+)$")
  if directionOnly then
    if directionOnly ~= "up" and directionOnly ~= "down" then
      return nil, nil, "missing-or-invalid-direction"
    end
    local steps = parseNumericQueryValue(query, {"steps", "n", "clicks"}) or 1
    return directionOnly, steps, nil
  end

  if route == "/slides/notes/font" then
    local direction = nil
    for pair in query:gmatch("[^&]+") do
      local key, value = pair:match("^([^=]+)=?(.*)$")
      if key == "dir" or key == "direction" then
        if value == "up" or value == "down" then
          direction = value
        end
      end
    end
    if not direction then
      return nil, nil, "missing-or-invalid-direction"
    end
    local steps = parseNumericQueryValue(query, {"steps", "n", "clicks"}) or 1
    return direction, steps, nil
  end

  return nil, nil, nil
end

local function parseNotesLayoutRequest(path)
  local route, query = splitRouteAndQuery(path)

  local byRoute = route:match("^/slides/notes/layout/(%d+)$")
  if byRoute then
    return tonumber(byRoute), nil
  end

  if route == "/slides/notes/layout" then
    local notesPercent = parseNumericQueryValue(query, {"notes", "notes_percent", "n"})
    if notesPercent then
      return notesPercent, nil
    end

    local previewPercent = parseNumericQueryValue(query, {"preview", "slides", "slides_percent"})
    if previewPercent then
      return 100 - previewPercent, nil
    end

    return nil, "missing-or-invalid-notes-percent"
  end

  return nil, nil
end

local function parseRefreshStatusRequest(path)
  local route = splitRouteAndQuery(path)

  if route == "/slides/status" then
    return true, nil
  end

  local byRoute = route:match("^/slides/status/([%w%._%-]+)$")
  if byRoute then
    return true, byRoute
  end

  return false, nil
end

local function findSlidesWindow(chromeApp)
  local targetWindow = nil
  local fallbackWindow = nil

  for _, oneWindow in ipairs(chromeApp:allWindows()) do
    local title = oneWindow:title() or ""
    if oneWindow:isStandard() and title:find("Google Slides", 1, true) and not title:find("Presenter view", 1, true) then
      if oneWindow:isFullScreen() then
        targetWindow = oneWindow
        break
      end
      if not targetWindow then
        targetWindow = oneWindow
      end
    end

    if oneWindow:isStandard() and not fallbackWindow then
      fallbackWindow = oneWindow
    end
  end

  if not targetWindow then
    targetWindow = fallbackWindow
  end

  return targetWindow
end

local function findPresenterWindow(chromeApp)
  local targetWindow = nil

  for _, oneWindow in ipairs(chromeApp:allWindows()) do
    local title = oneWindow:title() or ""
    if oneWindow:isStandard() and title:find("Presenter view", 1, true) then
      if oneWindow:isFullScreen() then
        return oneWindow
      end
      if not targetWindow then
        targetWindow = oneWindow
      end
    end
  end

  return targetWindow
end

local function jumpToSlide(slideNumber)
  if type(slideNumber) ~= "number" or slideNumber < 1 then
    return false, "invalid-slide-number"
  end

  local chrome = hs.application.get("Google Chrome")
  if not chrome then
    return false, "chrome-not-running"
  end

  local targetWindow = findSlidesWindow(chrome)

  if not targetWindow then
    return false, "slides-window-not-found"
  end

  chrome:activate(true)
  targetWindow:focus()
  hs.timer.usleep(180000)
  hs.eventtap.keyStrokes(tostring(math.floor(slideNumber)))
  hs.timer.usleep(70000)
  hs.eventtap.keyStroke({}, "return")
  return true, "jumped"
end

local function appleScriptQuoted(value)
  local text = tostring(value or "")
  text = text:gsub("\\", "\\\\")
  text = text:gsub('"', '\\"')
  return '"' .. text .. '"'
end

local function findKeynoteAppPath()
  for _, appPath in ipairs(keynoteAppPaths) do
    if hs.fs.attributes(appPath) then
      return appPath
    end
  end
  return nil
end

local function frameArea(frame)
  if not frame then
    return 0
  end
  return math.max(0, frame.w or 0) * math.max(0, frame.h or 0)
end

local function centerDistanceSquared(a, b)
  if not a or not b then
    return 0
  end
  local ax = (a.x or 0) + ((a.w or 0) / 2)
  local ay = (a.y or 0) + ((a.h or 0) / 2)
  local bx = (b.x or 0) + ((b.w or 0) / 2)
  local by = (b.y or 0) + ((b.h or 0) / 2)
  local dx = ax - bx
  local dy = ay - by
  return (dx * dx) + (dy * dy)
end

local function pickScreenByRole(role)
  local mainScreen = hs.screen.mainScreen()
  local screens = hs.screen.allScreens()
  if not mainScreen or #screens == 0 then
    return nil
  end

  local lowered = tostring(role or ""):lower()
  if lowered == "desktop" or lowered == "mirrored" or lowered == "mirror" or lowered == "primary" or lowered == "main" or lowered == "notes" then
    return mainScreen
  end

  if lowered == "extended" or lowered == "secondary" or lowered == "nonmain" or lowered == "external" or lowered == "slides" then
    local mainFrame = mainScreen:frame()
    local best = nil
    for _, screen in ipairs(screens) do
      if screen:id() ~= mainScreen:id() then
        if not best then
          best = screen
        else
          local screenFrame = screen:frame()
          local bestFrame = best:frame()
          local screenArea = frameArea(screenFrame)
          local bestArea = frameArea(bestFrame)
          if screenArea > bestArea or (screenArea == bestArea and centerDistanceSquared(screenFrame, mainFrame) > centerDistanceSquared(bestFrame, mainFrame)) then
            best = screen
          end
        end
      end
    end
    return best or mainScreen
  end

  return mainScreen
end

local function arrangeKeynoteDocumentWindow()
  local keynoteApp = hs.application.get(keynoteBundleId)
  if not keynoteApp then
    return "keynote-app-not-running"
  end

  local slidesScreen = pickScreenByRole(keynoteSlideDisplay)
  local notesScreen = pickScreenByRole(keynoteNotesDisplay)
  if not slidesScreen then
    return "slides-screen-not-found"
  end

  local windows = keynoteApp:allWindows()
  local targetWindow = nil
  for _, window in ipairs(windows) do
    local title = window:title() or ""
    if window:isStandard() and title ~= "" then
      targetWindow = window
      break
    end
  end

  if not targetWindow then
    targetWindow = keynoteApp:mainWindow() or keynoteApp:focusedWindow()
  end

  if not targetWindow then
    return "keynote-window-not-found"
  end

  local slidesFrame = slidesScreen:frame()
  targetWindow:moveToScreen(slidesScreen, false, true)
  targetWindow:setFrame(slidesFrame, 0)
  targetWindow:focus()

  local notesName = notesScreen and (notesScreen:name() or tostring(notesScreen:id())) or "unknown"
  return "slidesScreen=" .. (slidesScreen:name() or tostring(slidesScreen:id())) .. ";notesScreen=" .. notesName
end

local function openKeynoteDeck(request)
  local attrs = hs.fs.attributes(request.resolvedPath)
  if not attrs then
    return false, "deck-not-found"
  end

  local slideBlock = ""
  if request.slide and request.slide > 1 then
    slideBlock = string.format([[
  try
    show slide %d of the front document
  end try
]], request.slide)
  end

  local script = string.format([[
tell application id %s
  activate
  open POSIX file %s
  delay 1
%s
end tell
]], appleScriptQuoted(keynoteBundleId), appleScriptQuoted(request.resolvedPath), slideBlock)

  local ok, output, descriptor = hs.osascript.applescript(script)
  if not ok then
    return false, tostring(output or descriptor or "keynote-automation-failed")
  end

  local arrangementDetail = arrangeKeynoteDocumentWindow()

  if request.mode == "present" then
    local presentScript = string.format([[
tell application id %s
  activate
  start the front document
end tell
]], appleScriptQuoted(keynoteBundleId))
    local presentOk, presentOutput, presentDescriptor = hs.osascript.applescript(presentScript)
    if not presentOk then
      return false, tostring(presentOutput or presentDescriptor or "keynote-present-failed")
    end
    return true, "opened;arranged=" .. arrangementDetail .. ";presented"
  end

  return true, "opened;arranged=" .. arrangementDetail .. ";" .. tostring(output or "")
end

local function adjustNotesFont(direction, steps)
  if direction ~= "up" and direction ~= "down" then
    return false, "invalid-direction"
  end

  if type(steps) ~= "number" or steps < 1 then
    return false, "invalid-step-count"
  end

  local stepCount = math.floor(steps)
  if stepCount > 100 then
    return false, "step-count-too-large"
  end

  local chrome = hs.application.get("Google Chrome")
  if not chrome then
    return false, "chrome-not-running"
  end

  local presenterWindow = findPresenterWindow(chrome)
  if not presenterWindow then
    return false, "presenter-window-not-found"
  end

  chrome:activate(true)
  presenterWindow:focus()
  hs.timer.usleep(180000)

  local ax = require("hs.axuielement")
  local root = ax.windowElement(presenterWindow)

  local speakerNotesTab = nil
  local zoomInButton = nil
  local zoomOutButton = nil
  local queue = {}
  local safetyCounter = 0
  if root then
    table.insert(queue, root)
  end

  while #queue > 0 and safetyCounter < 5000 do
    safetyCounter = safetyCounter + 1
    local element = table.remove(queue, 1)
    local role = element:attributeValue("AXRole")

    if role == "AXRadioButton" then
      local title = tostring(element:attributeValue("AXTitle") or "")
      if title == "SPEAKER NOTES" then
        speakerNotesTab = element
      end
    elseif role == "AXButton" then
      local description = tostring(element:attributeValue("AXDescription") or "")
      if description == "Zoom in" then
        zoomInButton = element
      elseif description == "Zoom out" then
        zoomOutButton = element
      end
    end

    local children = element:attributeValue("AXChildren")
    if type(children) == "table" then
      for _, child in ipairs(children) do
        if type(child) == "userdata" then
          table.insert(queue, child)
        end
      end
    end
  end

  if speakerNotesTab then
    local selected = tostring(speakerNotesTab:attributeValue("AXValue") or "")
    if selected ~= "1" and selected ~= "true" then
      speakerNotesTab:performAction("AXPress")
      hs.timer.usleep(120000)
    end
  end

  local targetButton = (direction == "up") and zoomInButton or zoomOutButton
  if not targetButton then
    local presenterFrame = presenterWindow:frame()
    if not presenterFrame or presenterFrame.w <= 0 then
      return false, "presenter-frame-not-found"
    end

    local centerX = math.floor(presenterFrame.x + presenterFrame.w - ((direction == "up") and 17 or 55) + 0.5)
    local centerY = math.floor(presenterFrame.y + (presenterFrame.h * 0.074) + 0.5)
    local originalMouse = hs.mouse.absolutePosition()

    for _ = 1, stepCount do
      hs.eventtap.leftClick({x = centerX, y = centerY})
      hs.timer.usleep(70000)
    end

    hs.mouse.absolutePosition(originalMouse)
    return true, string.format("adjusted:%s:%d:x=%d:y=%d:source=coords-fallback", direction, stepCount, centerX, centerY)
  end

  local frame = targetButton:attributeValue("AXFrame")
  local centerX = -1
  local centerY = -1
  if type(frame) == "table" then
    local fx = frame.x or frame.X or frame[1] or 0
    local fy = frame.y or frame.Y or frame[2] or 0
    local fw = frame.w or frame.W or frame[3] or 0
    local fh = frame.h or frame.H or frame[4] or 0
    centerX = math.floor(fx + (fw / 2) + 0.5)
    centerY = math.floor(fy + (fh / 2) + 0.5)
  end

  for _ = 1, stepCount do
    targetButton:performAction("AXPress")
    hs.timer.usleep(70000)
  end

  return true, string.format("adjusted:%s:%d:x=%d:y=%d:source=axpress", direction, stepCount, centerX, centerY)
end

local function findNotesDivider(presenterWindow, root)
  local presenterFrame = presenterWindow:frame()
  if not presenterFrame then
    return nil
  end

  local leftLimit = presenterFrame.x + (presenterFrame.w * 0.10)
  local rightLimit = presenterFrame.x + (presenterFrame.w * 0.90)
  local queue = {root}
  local bestCandidate = nil
  local bestScore = -1
  local safetyCounter = 0

  while #queue > 0 and safetyCounter < 5000 do
    safetyCounter = safetyCounter + 1
    local element = table.remove(queue, 1)
    local role = tostring(element:attributeValue("AXRole") or "")
    local frame = element:attributeValue("AXFrame")

    if (role == "AXGroup" or role == "AXSplitter") and type(frame) == "table" then
      local fx = frame.x or frame.X or frame[1] or 0
      local fy = frame.y or frame.Y or frame[2] or 0
      local fw = frame.w or frame.W or frame[3] or 0
      local fh = frame.h or frame.H or frame[4] or 0
      local centerX = fx + (fw / 2)

      if fw > 0 and fw <= 20 and fh >= presenterFrame.h * 0.45 and centerX >= leftLimit and centerX <= rightLimit then
        local score = fh
        if centerX >= presenterFrame.x + (presenterFrame.w * 0.25) and centerX <= presenterFrame.x + (presenterFrame.w * 0.75) then
          score = score + 500
        end
        if fh >= presenterFrame.h * 0.75 then
          score = score + 250
        end

        if score > bestScore then
          bestScore = score
          bestCandidate = {
            element = element,
            frame = {x = fx, y = fy, w = fw, h = fh},
          }
        end
      end
    end

    local children = element:attributeValue("AXChildren")
    if type(children) == "table" then
      for _, child in ipairs(children) do
        if type(child) == "userdata" then
          table.insert(queue, child)
        end
      end
    end
  end

  return bestCandidate
end

setNotesPaneLayout = function(notesPercent)
  if type(notesPercent) ~= "number" then
    return false, "invalid-notes-percent"
  end

  local targetNotesPercent = math.floor(notesPercent + 0.5)
  if targetNotesPercent < 55 or targetNotesPercent > 90 then
    return false, "notes-percent-out-of-range"
  end

  local chrome = hs.application.get("Google Chrome")
  if not chrome then
    return false, "chrome-not-running"
  end

  local presenterWindow = findPresenterWindow(chrome)
  if not presenterWindow then
    return false, "presenter-window-not-found"
  end

  chrome:activate(true)
  presenterWindow:focus()
  hs.timer.usleep(180000)

  local ax = require("hs.axuielement")
  local root = ax.windowElement(presenterWindow)
  if not root then
    return false, "presenter-ax-root-not-found"
  end

  local presenterFrame = presenterWindow:frame()
  if not presenterFrame or presenterFrame.w <= 0 then
    return false, "presenter-frame-not-found"
  end

  local previewPercent = 100 - targetNotesPercent
  local targetX = math.floor(presenterFrame.x + (presenterFrame.w * previewPercent / 100) + 0.5)

  local minimumX = math.floor(presenterFrame.x + (presenterFrame.w * 0.10) + 0.5)
  local maximumX = math.floor(presenterFrame.x + (presenterFrame.w * 0.90) + 0.5)
  if targetX < minimumX then targetX = minimumX end
  if targetX > maximumX then targetX = maximumX end

  local divider = findNotesDivider(presenterWindow, root)
  local source = "ax"
  local startX = nil
  local startY = nil
  if divider then
    startX = math.floor(divider.frame.x + (divider.frame.w / 2) + 0.5)
    startY = math.floor(divider.frame.y + (divider.frame.h / 2) + 0.5)
  else
    -- Chrome sometimes hides the web contents from AX; the divider is still draggable.
    source = "coords-fallback"
    startX = math.floor(presenterFrame.x + (presenterFrame.w * 0.50) + 0.5)
    startY = math.floor(presenterFrame.y + (presenterFrame.h * 0.50) + 0.5)
  end

  local originalMouse = hs.mouse.absolutePosition()
  hs.eventtap.event.newMouseEvent(hs.eventtap.event.types.leftMouseDown, {x = startX, y = startY}):post()
  hs.timer.usleep(120000)
  hs.eventtap.event.newMouseEvent(hs.eventtap.event.types.leftMouseDragged, {x = targetX, y = startY}):post()
  hs.timer.usleep(200000)
  hs.eventtap.event.newMouseEvent(hs.eventtap.event.types.leftMouseUp, {x = targetX, y = startY}):post()
  hs.timer.usleep(250000)
  hs.mouse.absolutePosition(originalMouse)

  local refreshedRoot = ax.windowElement(presenterWindow)
  local refreshedDivider = nil
  if refreshedRoot then
    refreshedDivider = findNotesDivider(presenterWindow, refreshedRoot)
  end

  if not refreshedDivider then
    return false, string.format(
      "layout-unverified:notes=%d:preview=%d:from=%d:to=%d:source=%s",
      targetNotesPercent,
      100 - targetNotesPercent,
      startX,
      targetX,
      source
    )
  end

  local actualX = refreshedDivider.frame.x + (refreshedDivider.frame.w / 2)
  local actualNotesPercent = math.floor((100 - (((actualX - presenterFrame.x) / presenterFrame.w) * 100)) + 0.5)
  if math.abs(actualNotesPercent - targetNotesPercent) > 1 then
    return false, string.format(
      "layout-mismatch:notes=%d:preview=%d:from=%d:to=%d:actualNotes=%d:source=%s",
      targetNotesPercent,
      100 - targetNotesPercent,
      startX,
      targetX,
      actualNotesPercent,
      source
    )
  end

  return true, string.format(
    "layout:notes=%d:preview=%d:from=%d:to=%d:actualNotes=%d:source=%s",
    targetNotesPercent,
    100 - targetNotesPercent,
    startX,
    targetX,
    actualNotesPercent,
    source
  )
end

local function onHttpRequest(method, path, _, _)
  if method == "GET" and path == "/slides/health" then
    return jsonResponse('{"ok":true,"service":"slides-trigger"}', 200)
  end

  if method == "GET" and path == "/keynote/health" then
    local rootExists = hs.fs.attributes(iCloudDriveRoot) ~= nil
    local keynotePath = findKeynoteAppPath()
    local keynoteExists = keynotePath ~= nil
    return jsonResponseValue({
      ok = rootExists and keynoteExists,
      service = "slides-trigger",
      keynote = true,
      icloudRoot = iCloudDriveRoot,
      icloudRootExists = rootExists,
      keynoteBundleId = keynoteBundleId,
      keynotePath = keynotePath,
      keynoteAvailable = keynoteExists,
    }, 200)
  end

  local isRefreshStatusRequest, requestedRunId = false, nil
  if method == "GET" then
    isRefreshStatusRequest, requestedRunId = parseRefreshStatusRequest(path)
  end

  if isRefreshStatusRequest then
    local targetRun = nil

    if requestedRunId then
      targetRun = refreshRunsById[requestedRunId]
      if not targetRun then
        return jsonResponseValue({
          ok = false,
          error = "run-not-found",
          runId = requestedRunId,
        }, 404)
      end
    elseif activeRefreshRunId then
      targetRun = refreshRunsById[activeRefreshRunId]
    elseif #refreshRunOrder > 0 then
      targetRun = refreshRunsById[refreshRunOrder[#refreshRunOrder]]
    end

    return jsonResponseValue(buildRefreshRunPayload(targetRun), 200)
  end

  local slidesLoadRequest, slidesLoadParseError = nil, nil
  if method == "GET" or method == "POST" then
    slidesLoadRequest, slidesLoadParseError = parseSlidesLoadRequest(path)
  end

  if slidesLoadParseError then
    return jsonResponseValue({
      ok = false,
      accepted = false,
      error = slidesLoadParseError,
    }, 400)
  end

  if slidesLoadRequest then
    local ok, run, reason = runSlidesTrigger({
      action = "load",
      slidesUrl = slidesLoadRequest.slidesUrl,
      presentationId = slidesLoadRequest.presentationId,
      presentationTitle = slidesLoadRequest.presentationTitle,
      presentationUrl = slidesLoadRequest.presentationUrl,
    })
    local payload = buildRefreshRunPayload(run)

    if ok then
      return jsonResponseValue(payload, 202)
    end

    if reason == "refresh-already-running" then
      payload.ok = false
      payload.accepted = false
      payload.message = "load already running"
      payload.detail = "the load command was not accepted because another slides task is already in progress"
      payload.error = "refresh-already-running"
      return jsonResponseValue(payload, 409)
    end

    payload.ok = false
    payload.accepted = false
    payload.error = payload.error or reason or "load-start-failed"
    return jsonResponseValue(payload, 500)
  end

  local keynoteLoadRequest, keynoteLoadParseError = nil, nil
  if method == "GET" or method == "POST" then
    keynoteLoadRequest, keynoteLoadParseError = parseKeynoteLoadRequest(path)
  end

  if keynoteLoadParseError then
    return jsonResponseValue({
      ok = false,
      error = keynoteLoadParseError,
    }, 400)
  end

  if keynoteLoadRequest then
    local ok, detail = openKeynoteDeck(keynoteLoadRequest)
    if ok then
      return jsonResponseValue({
        ok = true,
        title = keynoteLoadRequest.title,
        icloudRelativePath = keynoteLoadRequest.relativePath,
        resolvedPath = keynoteLoadRequest.resolvedPath,
        mode = keynoteLoadRequest.mode,
        slide = keynoteLoadRequest.slide,
        detail = detail,
      }, 200)
    end

    local status = detail == "deck-not-found" and 404 or 500
    return jsonResponseValue({
      ok = false,
      error = detail,
      title = keynoteLoadRequest.title,
      icloudRelativePath = keynoteLoadRequest.relativePath,
      resolvedPath = keynoteLoadRequest.resolvedPath,
    }, status)
  end

  local slideNumber = nil
  if method == "GET" or method == "POST" then
    slideNumber = parseSlideNumberFromPath(path)
  end

  if slideNumber then
    local ok, detail = jumpToSlide(slideNumber)
    if ok then
      local body = string.format('{"ok":true,"slide":%d,"detail":"%s"}', slideNumber, jsonEscape(detail))
      return jsonResponse(body, 200)
    end

    local body = string.format('{"ok":false,"slide":%d,"error":"%s"}', slideNumber, jsonEscape(detail))
    return jsonResponse(body, 500)
  end

  local notesDirection, notesSteps, notesParseError = nil, nil, nil
  if method == "GET" or method == "POST" then
    notesDirection, notesSteps, notesParseError = parseNotesFontRequest(path)
  end

  if notesParseError then
    local body = string.format('{"ok":false,"error":"%s"}', jsonEscape(notesParseError))
    return jsonResponse(body, 400)
  end

  if notesDirection and notesSteps then
    local ok, detail = adjustNotesFont(notesDirection, notesSteps)
    if ok then
      local body = string.format('{"ok":true,"direction":"%s","steps":%d,"detail":"%s"}', notesDirection, notesSteps, jsonEscape(detail))
      return jsonResponse(body, 200)
    end
    local body = string.format('{"ok":false,"direction":"%s","steps":%d,"error":"%s"}', notesDirection, notesSteps, jsonEscape(detail))
    return jsonResponse(body, 500)
  end

  local notesLayoutPercent, notesLayoutParseError = nil, nil
  if method == "GET" or method == "POST" then
    notesLayoutPercent, notesLayoutParseError = parseNotesLayoutRequest(path)
  end

  if notesLayoutParseError then
    local body = string.format('{"ok":false,"error":"%s"}', jsonEscape(notesLayoutParseError))
    return jsonResponse(body, 400)
  end

  if notesLayoutPercent then
    local ok, detail = setNotesPaneLayout(notesLayoutPercent)
    if ok then
      local body = string.format('{"ok":true,"notesPercent":%d,"previewPercent":%d,"detail":"%s"}', notesLayoutPercent, 100 - notesLayoutPercent, jsonEscape(detail))
      return jsonResponse(body, 200)
    end
    local body = string.format('{"ok":false,"notesPercent":%d,"previewPercent":%d,"error":"%s"}', notesLayoutPercent, 100 - notesLayoutPercent, jsonEscape(detail))
    return jsonResponse(body, 500)
  end

  if (method == "GET" or method == "POST") and path == "/slides/run" then
    local ok, run, reason = runSlidesTrigger()
    local payload = buildRefreshRunPayload(run)

    if ok then
      return jsonResponseValue(payload, 202)
    end

    if reason == "refresh-already-running" then
      payload.ok = false
      payload.accepted = false
      payload.message = "refresh already running"
      payload.detail = "the refresh command was not accepted because another refresh is already in progress"
      payload.error = "refresh-already-running"
      return jsonResponseValue(payload, 409)
    end

    payload.ok = false
    payload.accepted = false
    payload.error = payload.error or reason or "refresh-start-failed"
    return jsonResponseValue(payload, 500)
  end

  return jsonResponse('{"ok":false,"error":"not_found"}', 404)
end

local server = hs.httpserver.new()
server:setInterface(httpInterface)
server:setPort(httpPort)
server:setCallback(onHttpRequest)
server:start()
_G.slidesHttpServer = server

print("Slides HTTP trigger ready: http://" .. httpInterface .. ":" .. tostring(httpPort) .. "/slides/run")
print("Slides HTTP load ready: http://" .. httpInterface .. ":" .. tostring(httpPort) .. "/slides/load")
print("Keynote HTTP load ready: http://" .. httpInterface .. ":" .. tostring(httpPort) .. "/keynote/load")
print("Slides HTTP status ready: http://" .. httpInterface .. ":" .. tostring(httpPort) .. "/slides/status")
print("Slides HTTP jump ready: http://" .. httpInterface .. ":" .. tostring(httpPort) .. "/slides/jump/<number>")
print("Slides HTTP notes font ready: http://" .. httpInterface .. ":" .. tostring(httpPort) .. "/slides/notes/font/up/<steps>")
print("Slides HTTP notes layout ready: http://" .. httpInterface .. ":" .. tostring(httpPort) .. "/slides/notes/layout/80")
